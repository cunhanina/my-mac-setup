# Brewfile — Declarative macOS Setup Stack
# Install everything with: brew bundle

# Core CLI & Git
brew "git"
brew "gh"

# Shell & Prompt
brew "starship"
brew "zoxide"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "eza"
brew "bat"
brew "glow"

# Languages & Toolchains
brew "uv"
brew "go"
brew "cmake"

# Productivity & Dashboard
brew "ical-buddy"

# Applications & Fonts
cask "raycast"
cask "visual-studio-code"
cask "iterm2"
cask "font-jetbrains-mono-nerd-font"
