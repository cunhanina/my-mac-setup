#!/usr/bin/env python3
import shutil
from pathlib import Path
from datetime import datetime, timedelta

# ===== BASE PATHS =====

DOWNLOADS = Path.home() / "Downloads"
DOCUMENTS = Path.home() / "Documents"
PICTURES = Path.home() / "Pictures"

# Subfolders inside Downloads
ARCHIVES_DIR = DOWNLOADS / "Archives"
MISC_DIR = DOWNLOADS / "Misc"

# Folders we should not recurse into (to avoid loops)
EXCLUDED_DIRS = {ARCHIVES_DIR, MISC_DIR}

# ===== FILE TYPE RULES =====

FILE_RULES = {
    "Images": {
        "extensions": [".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp"],
        "destination": PICTURES,
    },
    "Documents": {
        "extensions": [".pdf", ".docx", ".txt", ".xlsx", ".pptx", ".csv"],
        "destination": DOCUMENTS,
    },
    "Archives": {
        "extensions": [".zip", ".tar", ".gz", ".rar"],
        "destination": ARCHIVES_DIR,
    },
}

# Files older than this will be reported (printed only)
OLD_FILE_DAYS = 90


# ===== HELPERS =====

def safe_move(src: Path, dst_dir: Path):
    """Move file without overwriting existing ones."""
    dst_dir.mkdir(parents=True, exist_ok=True)
    dst = dst_dir / src.name

    if dst.exists():
        stem = src.stem
        suffix = src.suffix
        counter = 1
        while dst.exists():
            dst = dst_dir / f"{stem}_{counter}{suffix}"
            counter += 1

    shutil.move(str(src), str(dst))
    print(f"➡️  {src}  →  {dst}")


def classify_and_move(file: Path):
    ext = file.suffix.lower()

    for rule in FILE_RULES.values():
        if ext in rule["extensions"]:
            safe_move(file, rule["destination"])
            return

    # Anything unmatched goes to Misc
    safe_move(file, MISC_DIR)


def report_old_files():
    cutoff = datetime.now() - timedelta(days=OLD_FILE_DAYS)
    old_files = []

    for item in DOWNLOADS.iterdir():
        if item.is_file():
            mtime = datetime.fromtimestamp(item.stat().st_mtime)
            if mtime < cutoff:
                old_files.append((item.name, mtime.date()))

    if not old_files:
        print("\n✅ No old files found in Downloads.")
        return

    print(f"\n📊 Files older than {OLD_FILE_DAYS} days in Downloads:")
    for name, date in sorted(old_files, key=lambda x: x[1]):
        print(f"  • {name} (last modified: {date})")


# ===== MAIN =====

def clean():
    if not DOWNLOADS.exists():
        print("❌ Downloads folder not found.")
        return

    print(f"🧹 Organizing {DOWNLOADS} (recursive scan)...\n")

    files = [
        p for p in DOWNLOADS.rglob("*")
        if p.is_file() and not any(parent in EXCLUDED_DIRS for parent in p.parents)
    ]

    for file in files:
        classify_and_move(file)

    report_old_files()
    print("\n✅ Done.")


if __name__ == "__main__":
    clean()
