#!/bin/zsh
source ~/bin/_styles.sh

# ---------------------------------------------------------------------------
# dupes — find duplicate files by content (MD5 checksum)
#
# Usage:
#   dupes              scan ~/Downloads
#   dupes ~/Pictures   scan a specific folder
#   dupes . --delete   interactive delete after scan
# ---------------------------------------------------------------------------

TARGET="${1:-$HOME/Downloads}"
DELETE=false
[[ "$2" == "--delete" || "$1" == "--delete" ]] && DELETE=true
[[ "$1" == "--delete" ]] && TARGET="$HOME/Downloads"

if [ ! -d "$TARGET" ]; then
    err "Directory not found: $TARGET"
    exit 1
fi

header "DUPLICATE FINDER  •  $TARGET"
echo ""
step "Scanning files (this may take a moment)..."

# Build checksum → file list map using a temp file
TMPFILE=$(mktemp /tmp/dupes_XXXXXX)
trap "rm -f $TMPFILE" EXIT

# Calculate MD5 for every file, write "hash filepath" to temp
find "$TARGET" -type f -not -name ".*" 2>/dev/null | while IFS= read -r f; do
    HASH=$(md5 -q "$f" 2>/dev/null)
    [ -n "$HASH" ] && echo "$HASH $f"
done | sort > "$TMPFILE"

# Find hashes that appear more than once
DUPE_HASHES=$(awk '{print $1}' "$TMPFILE" | sort | uniq -d)

if [ -z "$DUPE_HASHES" ]; then
    ok "No duplicates found in $TARGET."
    exit 0
fi

# Display grouped duplicates
TOTAL_GROUPS=0
TOTAL_WASTED=0

echo "$DUPE_HASHES" | while read -r HASH; do
    FILES=$(grep "^$HASH " "$TMPFILE" | awk '{print substr($0, length($1)+2)}')
    COUNT=$(echo "$FILES" | wc -l | tr -d ' ')
    
    # Get file size from first file
    FIRST=$(echo "$FILES" | head -1)
    SIZE=$(du -sh "$FIRST" 2>/dev/null | cut -f1)

    echo "  ${YELLOW}Duplicate group${RESET}  •  ${SIZE} each  •  ${COUNT} copies"
    echo "$FILES" | awk '{print "    · " $0}'
    echo ""
    
    TOTAL_GROUPS=$((TOTAL_GROUPS + 1))
done

GROUPS=$(echo "$DUPE_HASHES" | wc -l | tr -d ' ')
warn "Found $GROUPS duplicate group(s)."

# ── Optional interactive delete ─────────────────────────────────────────────
if $DELETE; then
    echo ""
    warn "For each group, the FIRST file is kept and the rest will be deleted."
    read -q "REPLY?  Proceed? (y/n) "
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "$DUPE_HASHES" | while read -r HASH; do
            FILES=$(grep "^$HASH " "$TMPFILE" | awk '{print substr($0, length($1)+2)}')
            # Keep the first, delete the rest
            echo "$FILES" | tail -n +2 | while IFS= read -r DUP; do
                rm "$DUP"
                ok "Deleted: $(basename "$DUP")"
            done
        done
        ok "Done."
    else
        err "Aborted — nothing deleted."
    fi
fi


