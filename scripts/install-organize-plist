#!/bin/zsh
source ~/bin/_styles.sh

# ---------------------------------------------------------------------------
# install-organize-plist — register the daily organize job with launchd
#
# Run once after cloning / pulling the repo:
#   ./scripts/install-organize-plist
# ---------------------------------------------------------------------------

PLIST_SRC="$(cd "$(dirname "$0")" && pwd)/com.maxykoin.organize.plist"
PLIST_DEST="$HOME/Library/LaunchAgents/com.maxykoin.organize.plist"
LOG_FILE="$HOME/Library/Logs/organize.log"

header "Installing daily organize job..."

# 1. Sanity check
if [ ! -f "$PLIST_SRC" ]; then
    err "Plist not found: $PLIST_SRC"
    exit 1
fi

# 2. Unload any existing version first (ignore errors if not loaded)
launchctl unload "$PLIST_DEST" 2>/dev/null

# 3. Copy plist to LaunchAgents
cp "$PLIST_SRC" "$PLIST_DEST"
ok "Plist copied → $PLIST_DEST"

# 4. Create log file so tail -f works immediately
touch "$LOG_FILE"
ok "Log file ready → $LOG_FILE"

# 5. Load the job
launchctl load "$PLIST_DEST"
ok "Job loaded — organize will run every day at 09:00."

info "To check it's registered: launchctl list | grep organize"
info "To read logs:             tail -f $LOG_FILE"
info "To run it right now:      launchctl start com.maxykoin.organize"
info "To remove the job:        launchctl unload $PLIST_DEST && rm $PLIST_DEST"


