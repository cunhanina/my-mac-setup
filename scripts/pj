#!/bin/zsh
source ~/bin/_styles.sh

CODING_ROOT="$HOME/Desktop/coding"

if ! command -v fzf &>/dev/null; then
    err "fzf not found. Install with: brew install fzf"
    exit 1
fi

if [[ ! -d "$CODING_ROOT" ]]; then
    err "$CODING_ROOT does not exist."
    exit 1
fi

# Any directory two levels deep containing a .git is a project.
# (matches the new/health/week convention: <lang>/<project-name>/.git)
SELECTION=$(find "$CODING_ROOT" -mindepth 1 -maxdepth 3 -name ".git" -type d 2>/dev/null \
    | sed 's|/\.git$||' \
    | sed "s|$CODING_ROOT/||" \
    | sort \
    | fzf --prompt="Jump to project ➜ " --height=40% --reverse --border)

[[ -z "$SELECTION" ]] && exit 0

TARGET_DIR="$CODING_ROOT/$SELECTION"

osascript <<EOF
tell application "iTerm"
    activate
    tell current window
        create tab with default profile
        tell current session
            write text "cd '$TARGET_DIR'; clear"
        end tell
    end tell
end tell
EOF
