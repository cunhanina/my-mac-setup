<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maxykoin.screenshot-mover</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/maxykoin/bin/screenshot_mover.py</string>
    </array>

    <!-- Run every 600 seconds (10 minutes) -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>/Users/maxykoin/Library/Logs/screenshot-mover.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxykoin/Library/Logs/screenshot-mover.log</string>

    <!-- Don't run immediately on login — wait for first interval -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>


