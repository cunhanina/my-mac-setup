#!/bin/zsh
source ~/bin/_styles.sh

# FIX: check git context FIRST, before reading branch or doing anything else.
# Previously BRANCH=$(git rev-parse ...) ran before the repo check, printing
# a stray error and silently setting BRANCH="" whenever run outside a repo.
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    err "Not a git repository."
    exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
MSG="${1:-Update: $(date '+%Y-%m-%d %H:%M')}"

header "💾 Saving Progress ($BRANCH)..."

# 1. Add & Commit
# We check status first to avoid "nothing to commit" errors
if [ -n "$(git status --porcelain)" ]; then
    echo "  👉 Adding files..."
    git add .
    echo "  👉 Committing..."
    git commit -m "$MSG" -q
else
    echo "  👉 No new changes to commit. Checking for push..."
fi

# 2. Smart Push Logic
echo "  👉 Checking remote status..."
git fetch -q

# Check if we are behind (remote has commits we don't)
BEHIND_COUNT=$(git rev-list HEAD..origin/$BRANCH --count 2>/dev/null || echo 0)

if [ "$BEHIND_COUNT" -gt 0 ]; then
    warn "Remote has changes you don't have!"
    echo "${BOLD}Incoming changes:${RESET}"
    git log HEAD..origin/$BRANCH --oneline --color | sed 's/^/  /'
    
    echo ""
    echo -n "  🔄 Sync (pull) changes and push? [y/N] "
    read RESPONSE
    
    if [[ "$RESPONSE" =~ ^[Yy]$ ]]; then
        echo "  ⬇️  Pulling changes..."
        if git pull --rebase -q; then
            echo "  ⬆️  Pushing..."
            git push -q
            ok "Synced & Saved successfully!"
        else
            err "Pull failed (conflict). Please fix manually."
            exit 1
        fi
    else
        warn "Push cancelled. Use 'git pull' manually when ready."
        exit 0
    fi
else
    echo "  ⬆️  Pushing..."
    if git push -q; then
        ok "Saved & Pushed successfully!"
    else
        warn "Push failed (check internet or permissions)."
    fi
fi


