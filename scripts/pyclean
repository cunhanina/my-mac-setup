#!/bin/zsh
# Try to load styles, but don't crash if missing
[ -f "$HOME/bin/_styles.sh" ] && source "$HOME/bin/_styles.sh"

# --- SAFETY FALLBACKS ---
if ! command -v header &> /dev/null; then
  header() { echo "\n🧹 $1"; }
  row() { printf "  %-20s %s\n" "$1" "$2"; }
  ok() { echo "  ✔ $1"; }
  info() { echo "  ℹ️  $1"; }
fi
# ------------------------

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    header "pyclean — Python Cache & Artifact Janitor"
    row "pyclean [dir]" "Recursively remove __pycache__, .ruff_cache, .pytest_cache, build, dist"
    row "pyclean -n [dir]" "Dry run: count and list what would be removed without deleting"
    exit 0
fi

DRY_RUN=false
if [[ "$1" == "-n" || "$1" == "--dry-run" ]]; then
    DRY_RUN=true
    shift
fi

# Default to current directory if no argument is given
TARGET_DIR="${1:-.}"
TARGET_ABS="$(cd "$TARGET_DIR" 2>/dev/null && pwd || echo "$TARGET_DIR")"

if $DRY_RUN; then
    header "Dry Run — Python Project Cleanup: $TARGET_ABS"
else
    header "Deep Cleaning Python Project: $TARGET_ABS"
fi

# Function to find, count, and destroy
destroy() {
    local pattern="$1"
    local description="$2"

    # 1. Count matches (silencing errors)
    local count=$(find "$TARGET_DIR" -name "$pattern" 2>/dev/null | wc -l | tr -d ' ')

    # 2. If found, delete them (or preview in dry-run mode)
    if [ "${count:-0}" -gt 0 ]; then
        if $DRY_RUN; then
            info "Would remove $count $description ($pattern)"
        else
            find "$TARGET_DIR" -name "$pattern" -exec rm -rf {} + 2>/dev/null
            ok "Removed $count $description ($pattern)"
        fi
    fi
}

# 1. Standard Python Junk
destroy "__pycache__" "bytecode folders"
destroy "*.pyc"       "compiled files"

# 2. Modern Tooling Caches (Ruff, Pytest, Mypy)
destroy ".pytest_cache" "test caches"
destroy ".ruff_cache"   "linter caches"
destroy ".mypy_cache"   "type check caches"
destroy ".coverage"     "coverage reports"

# 3. Build Artifacts (from packaging)
destroy "dist"        "distribution folders"
destroy "build"       "build folders"
destroy "*.egg-info"  "egg metadata"

# 4. OS Junk
destroy ".DS_Store"   "macOS metadata"

echo "" 
info "Sparkling clean. ✨"
