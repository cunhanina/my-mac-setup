#!/bin/zsh
source "$HOME/bin/_styles.sh"

# ---------------------------------------------------------------------------
# morning — daily orientation dashboard
#
# Dependencies: brew install icalbuddy
# Usage:
#   morning          full dashboard
#   morning --quick  skip web requests (weather/quotes)
# ---------------------------------------------------------------------------

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    header "morning — Daily Orientation Dashboard"
    row "morning" "Full dashboard (weather, git status, calendar, tasks, quote)"
    row "morning --quick" "Offline/fast mode (skips weather and quote API calls)"
    exit 0
fi

QUICK=false
[[ "$1" == "--quick" || "$1" == "-q" ]] && QUICK=true

# Fire network requests in parallel in the background so they run while local checks execute
if ! $QUICK; then
    WEATHER_TMP=$(mktemp)
    QUOTE_TMP=$(mktemp)
    trap 'rm -f "$WEATHER_TMP" "$QUOTE_TMP"' EXIT

    (curl -fsSL --max-time 3 "https://wttr.in/${WEATHER_CITY}?format=%c+%t+•+Feels+like+%f+•+%w" > "$WEATHER_TMP" 2>/dev/null) &
    WEATHER_PID=$!

    (curl -fsSL --max-time 3 "https://zenquotes.io/api/today" 2>/dev/null \
        | grep -o '"q":"[^"]*","a":"[^"]*"' \
        | head -1 \
        | sed 's/"q":"//; s/","a":"/ — /; s/"//g' > "$QUOTE_TMP" 2>/dev/null) &
    QUOTE_PID=$!
fi

clear
echo ""

# ── 0. GREETING ─────────────────────────────────────────────────────────────
HOUR=$(date +%H)
if (( 10#$HOUR < 12 )); then
    GREETING="Good morning"
    ICON="🌅"
elif (( 10#$HOUR < 18 )); then
    GREETING="Good afternoon"
    ICON="☀️"
else
    GREETING="Good evening"
    ICON="🌙"
fi

echo "${BOLD}${CYAN}  ${ICON}  ${GREETING}, $(id -un) — $(date '+%A, %B %d')${RESET}"
echo "  ─────────────────────────────────────────────────"
echo ""

# ── 1. WEATHER ──────────────────────────────────────────────────────────────
if ! $QUICK; then
    header "WEATHER  •  ${WEATHER_CITY}"
    wait "$WEATHER_PID" 2>/dev/null
    WEATHER=$(cat "$WEATHER_TMP" 2>/dev/null)
    if [[ -n "$WEATHER" && "$WEATHER" != *"Unknown"* ]]; then
        echo "  $WEATHER"
    else
        warn "  Weather unavailable."
    fi
    echo ""
fi

# ── 2. ONGOING WORK (Git Status) ────────────────────────────────────────────
header "ONGOING WORK"

FOUND_CHANGES=false
while IFS= read -r -d '' gitdir; do
    REPO_DIR=$(dirname "$gitdir")
    REPO_NAME=$(basename "$REPO_DIR")
    PORCELAIN=$(git -C "$REPO_DIR" status --porcelain 2>/dev/null)
    AHEAD=$(git -C "$REPO_DIR" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)

    if [[ -n "$PORCELAIN" || "$AHEAD" -gt 0 ]]; then
        DETAILS=()
        if [[ -n "$PORCELAIN" ]]; then
            CHANGE_COUNT=$(echo "$PORCELAIN" | wc -l | tr -d ' ')
            DETAILS+=("$CHANGE_COUNT uncommitted file(s)")
        fi
        if [[ "$AHEAD" -gt 0 ]]; then
            DETAILS+=("${YELLOW}$AHEAD unpushed commit(s)${RESET}")
        fi
        echo "  ${BOLD}$REPO_NAME${RESET}  •  ${(j:  •  :)DETAILS}"
        FOUND_CHANGES=true
    fi
done < <(find "$CODING_ROOT" -maxdepth 3 -name ".git" -type d -print0 2>/dev/null)

if ! $FOUND_CHANGES; then
    ok "  All clean. No uncommitted or unpushed work."
fi
echo ""

# ── 3. TODAY'S CALENDAR EVENTS ──────────────────────────────────────────────
header "TODAY'S EVENTS"
if command -v icalbuddy &>/dev/null; then
    EVENTS=$(icalbuddy -f -ea -nc -npn -b "  • " -eep "notes,url,location" eventsToday 2>/dev/null)
    if [[ -n "$EVENTS" ]]; then
        echo "$EVENTS"
    else
        ok "  Nothing scheduled for today."
    fi
else
    warn "  icalbuddy not installed. Run: brew install icalbuddy"
fi
echo ""

# ── 4. UPCOMING (next 3 days) ───────────────────────────────────────────────
header "COMING UP  •  next 3 days"
if command -v icalbuddy &>/dev/null; then
    UPCOMING=$(icalbuddy -f -ea -nc -npn -b "  • " -eep "notes,url,location" eventsFrom:tomorrow to:today+3 2>/dev/null)
    if [[ -n "$UPCOMING" ]]; then
        echo "$UPCOMING"
    else
        ok "  Clear horizon."
    fi
fi
echo ""

# ── 5. PENDING TASKS ────────────────────────────────────────────────────────
header "PENDING TASKS"

GLOBAL_TASKS=""
if [[ -f "$NOTES_FILE" ]]; then
    GLOBAL_TASKS=$(grep -E '^[ \t]*[-*] \[ \] [^[:space:]]' "$NOTES_FILE" 2>/dev/null)
    if [[ -n "$GLOBAL_TASKS" ]]; then
        echo "  ${BOLD}Global Notes:${RESET}"
        echo "$GLOBAL_TASKS" | sed -E 's/^[ \t]*[-*] \[ \]/    • /' | head -5
    fi
fi

TODO_COUNT=0
while IFS= read -r -d '' TODO; do
    PROJECT=$(basename "$(dirname "$TODO")")
    TASKS=$(grep -E '^[ \t]*[-*] \[ \] [^[:space:]]' "$TODO" 2>/dev/null)
    if [[ -n "$TASKS" ]]; then
        TODO_COUNT=$((TODO_COUNT + 1))
        echo "  ${BOLD}$PROJECT:${RESET}"
        echo "$TASKS" | sed -E 's/^[ \t]*[-*] \[ \]/    • /' | head -3
    fi
done < <(find "$CODING_ROOT" -maxdepth 3 -name "todo.md" -print0 2>/dev/null)

if [[ "$TODO_COUNT" -eq 0 && -z "$GLOBAL_TASKS" ]]; then
    ok "  Zero pending tasks. Inbox zero!"
fi
echo ""

# ── 6. QUOTE OF THE DAY ─────────────────────────────────────────────────────
header "THOUGHT FOR TODAY"

QUOTE=""
if ! $QUICK; then
    wait "$QUOTE_PID" 2>/dev/null
    QUOTE=$(cat "$QUOTE_TMP" 2>/dev/null)
fi

if [[ -z "$QUOTE" ]]; then
    QUOTES=(
        "The best time to plant a tree was 20 years ago. The second best time is now."
        "Simplicity is the ultimate sophistication. — Leonardo da Vinci"
        "Every expert was once a beginner."
        "Make it work, make it right, make it fast. — Kent Beck"
        "A ship in harbor is safe, but that's not what ships are for."
        "Done is better than perfect."
        "The secret of getting ahead is getting started. — Mark Twain"
        "Programs must be written for people to read, and only incidentally for machines to execute."
        "Stay hungry, stay foolish. — Steve Jobs"
        "First, solve the problem. Then, write the code. — John Johnson"
    )
    QUOTE="${QUOTES[$(( RANDOM % ${#QUOTES[@]} + 1 ))]}"
fi

echo "  ${QUOTE}"
echo ""

