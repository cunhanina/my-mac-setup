#!/bin/zsh
source "$HOME/bin/_styles.sh"

# ---------------------------------------------------------------------------
# use — activate the uv virtual environment for a project
#
# Usage:
#   use          activate .venv in the current directory (or git root)
#   use <name>   activate .venv for a named project under $CODING_ROOT
#   use off      deactivate the current environment
# ---------------------------------------------------------------------------

# Ensure 'use' is being sourced into the current shell, not executed as a child process
if [[ "${ZSH_EVAL_CONTEXT:-}" != *:file* ]]; then
    err "'use' must be sourced so it can modify your active shell."
    info "Run 'use' via the shell alias (alias use='source ~/bin/_use.sh')."
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    header "use — Python Virtualenv Activator"
    row "use" "Activate .venv in current directory or git root"
    row "use <name>" "Find project under $CODING_ROOT and activate its .venv"
    row "use off" "Deactivate the active virtual environment"
    return 0
fi

# MODE: OFF — deactivate
if [[ "$1" == "off" ]]; then
    if [ -z "$VIRTUAL_ENV" ]; then
        warn "No virtual environment is currently active."
        return 0
    fi
    deactivate
    ok "Environment deactivated."
    return 0
fi

# MODE: NAMED PROJECT — find it under the coding tree
if [ -n "$1" ]; then
    SEARCH="$1"
    BASE="$CODING_ROOT"

    # Exact match first, then partial
    TARGET=$(find "$BASE" -maxdepth 3 -type d -name "$SEARCH" -print -quit 2>/dev/null)
    if [ -z "$TARGET" ]; then
        TARGET=$(find "$BASE" -maxdepth 3 -type d -name "*$SEARCH*" -print -quit 2>/dev/null)
    fi

    if [ -z "$TARGET" ]; then
        err "Project '$SEARCH' not found under $BASE."
        return 1
    fi

    VENV="$TARGET/.venv"
    if [ ! -d "$VENV" ]; then
        err "No .venv found in $TARGET."
        info "Run: cd $TARGET && uv venv"
        return 1
    fi

    source "$VENV/bin/activate"
    ok "Activated: $TARGET"
    info "Python → $(python --version 2>&1)"
    return 0
fi

# MODE: CURRENT DIRECTORY — walk up to git root first, then cwd
if git rev-parse --git-dir > /dev/null 2>&1; then
    PROJECT_ROOT=$(git rev-parse --show-toplevel)
else
    PROJECT_ROOT="$(pwd)"
fi

VENV="$PROJECT_ROOT/.venv"

if [ ! -d "$VENV" ]; then
    err "No .venv found in $PROJECT_ROOT."
    info "Run: uv venv"
    return 1
fi

source "$VENV/bin/activate"
ok "Activated: $(basename "$PROJECT_ROOT")"
info "Python → $(python --version 2>&1)"