#!/bin/zsh
source ~/bin/_styles.sh

# ---------------------------------------------------------------------------
# use — activate the uv virtual environment for a project
#
# Usage:
#   use          activate .venv in the current directory (or git root)
#   use <name>   activate .venv for a named project under ~/Desktop/coding
#   use off      deactivate the current environment
# ---------------------------------------------------------------------------

# MODE: OFF — deactivate
if [[ "$1" == "off" ]]; then
    if [ -z "$VIRTUAL_ENV" ]; then
        warn "No virtual environment is currently active."
        return 0
    fi
    deactivate
    ok "Environment deactivated."
    return 0
fi

# MODE: NAMED PROJECT — find it under the coding tree
if [ -n "$1" ]; then
    SEARCH="$1"
    BASE="$HOME/Desktop/coding"

    # Exact match first, then partial
    TARGET=$(find "$BASE" -maxdepth 3 -type d -name "$SEARCH" -print -quit 2>/dev/null)
    if [ -z "$TARGET" ]; then
        TARGET=$(find "$BASE" -maxdepth 3 -type d -name "*$SEARCH*" -print -quit 2>/dev/null)
    fi

    if [ -z "$TARGET" ]; then
        err "Project '$SEARCH' not found under $BASE."
        return 1
    fi

    VENV="$TARGET/.venv"
    if [ ! -d "$VENV" ]; then
        err "No .venv found in $TARGET."
        info "Run: cd $TARGET && uv venv"
        return 1
    fi

    source "$VENV/bin/activate"
    ok "Activated: $TARGET"
    info "Python → $(python --version 2>&1)"
    return 0
fi

# MODE: CURRENT DIRECTORY — walk up to git root first, then cwd
if git rev-parse --git-dir > /dev/null 2>&1; then
    PROJECT_ROOT=$(git rev-parse --show-toplevel)
else
    PROJECT_ROOT="$(pwd)"
fi

VENV="$PROJECT_ROOT/.venv"

if [ ! -d "$VENV" ]; then
    err "No .venv found in $PROJECT_ROOT."
    info "Run: uv venv"
    return 1
fi

source "$VENV/bin/activate"
ok "Activated: $(basename "$PROJECT_ROOT")"
info "Python → $(python --version 2>&1)"