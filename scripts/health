#!/bin/zsh

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Health
# @raycast.mode fullOutput

# Optional parameters:
# @raycast.icon 🖥️
# @raycast.packageName System

source "$HOME/bin/_styles.sh"

check_health() {
    local val=${1%%%}
    local limit=$2
    if [ "$val" -gt "$limit" ]; then
        echo "${RED}${val}%${RESET}"
    else
        echo "${GREEN}${val}%${RESET}"
    fi
}

header "SYSTEM VITALS"

arch=$(uname -m)
[ "$arch" = "arm64" ] && arch_label="Apple Silicon (MPS Ready)" || arch_label="Intel x86"
row "Architecture" "$arch_label"

load_avg=$(sysctl -n vm.loadavg | awk '{print $2}')
row "CPU Load (1m)" "$load_avg"

boot_time=$(sysctl -n kern.boottime | awk '{print $4}' | tr -d ',')
current_time=$(date +%s)
up_seconds=$((current_time - boot_time))
row "Uptime" "$((up_seconds / 86400))d $(( (up_seconds % 86400) / 3600 ))h"

disk_pct=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')
disk_free=$(df -h / | awk 'NR==2 {print $4}')
row "Disk Usage" "$(check_health "$disk_pct" 90) (${disk_free} free)"

mem_total=$(($(sysctl -n hw.memsize) / 1024 / 1024 / 1024))
mem_pressure=$(memory_pressure | grep "System-wide" | awk '{print $5}' | tr -d '%')
row "RAM" "${mem_total} GB total  •  pressure $(check_health "$mem_pressure" 60)"

header "BATTERY"

if pmset -g batt | grep -q "InternalBattery"; then
    batt_pct=$(pmset -g batt | grep -o "[0-9]*%" | head -1)
    if pmset -g batt | grep -q "discharging"; then
        batt_status="Discharging"
    elif pmset -g batt | grep -q "charging"; then
        batt_status="Charging"
    else
        batt_status="Plugged in (full)"
    fi
    row "Charge" "$batt_pct  •  $batt_status"

    TIME_LEFT=$(pmset -g batt | grep -o "[0-9]*:[0-9]*" | head -1)
    [ -n "$TIME_LEFT" ] && row "Time remaining" "$TIME_LEFT"

    POWER_DATA=$(system_profiler SPPowerDataType 2>/dev/null)
    CYCLE_COUNT=$(echo "$POWER_DATA" | awk '/Cycle Count/{print $3}')
    MAX_CAPACITY=$(echo "$POWER_DATA" | awk '/Maximum Capacity/{print $3}')
    CONDITION=$(echo "$POWER_DATA" | awk '/Condition/{print $2}')

    if [ -n "$CYCLE_COUNT" ]; then
        CYCLES_LEFT=$((1000 - CYCLE_COUNT))
        if [ "$CYCLE_COUNT" -lt 500 ]; then
            CYCLE_COLOR="$GREEN"
        elif [ "$CYCLE_COUNT" -lt 800 ]; then
            CYCLE_COLOR="$YELLOW"
        else
            CYCLE_COLOR="$RED"
        fi
        row "Cycle count" "${CYCLE_COLOR}${CYCLE_COUNT}${RESET} / 1000  (≈${CYCLES_LEFT} remaining)"
    fi

    [ -n "$MAX_CAPACITY" ] && row "Max capacity" "$MAX_CAPACITY of design capacity"
    [ -n "$CONDITION" ]    && row "Condition"    "$CONDITION"

    TEMP_RAW=$(ioreg -rn "AppleSmartBattery" 2>/dev/null | grep '"Temperature"' | awk '{print $3}')
    if [ -n "$TEMP_RAW" ]; then
        TEMP_C=$(echo "scale=1; $TEMP_RAW / 100" | bc 2>/dev/null)
        [ -n "$TEMP_C" ] && row "Temperature" "${TEMP_C}°C"
    fi
fi

header "CONNECTIVITY"

iface=$(route get default 2>/dev/null | awk '/interface/ {print $2}')
row "Interface" "${iface:-Disconnected}"

if [ "$iface" = "en0" ] || [ "$iface" = "en1" ]; then
    ssid=$(networksetup -getairportnetwork "$iface" 2>/dev/null | sed 's/Current Wi-Fi Network: //')
    [[ "$ssid" != *"You are not associated"* && -n "$ssid" ]] && row "WiFi" "$ssid"
fi

row "Local IP"  "$(ipconfig getifaddr "$iface" 2>/dev/null || echo N/A)"
row "Public IP" "$(curl -s --max-time 2 https://ifconfig.me || echo Unreachable)"

header "DEV STACK"

git_user=$(git config --global user.name)
[ -n "$git_user" ] && row "Git user" "$git_user" || row "Git" "${RED}unconfigured${RESET}"

command -v uv &>/dev/null \
    && row "uv" "${GREEN}v$(uv --version | awk '{print $2}')${RESET}" \
    || row "uv" "${RED}not installed${RESET}"

pgrep -f Docker >/dev/null \
    && row "Docker" "${GREEN}Running${RESET}" \
    || row "Docker" "${YELLOW}Stopped${RESET}"
