#!/bin/zsh
source "$HOME/bin/_styles.sh"

# ---------------------------------------------------------------------------
# week — weekly activity review
#
# Usage:
#   week          this week's summary
#   week last     last week's summary
# ---------------------------------------------------------------------------

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    header "week — Weekly Activity Review"
    row "week" "Summary of git commits, completed tasks, journal & calendar this week"
    row "week last" "Summary for the previous week (Mon–Sun)"
    exit 0
fi

# ── Date range setup ────────────────────────────────────────────────────────
if [[ "$1" == "last" ]]; then
    LABEL="LAST WEEK"
    SINCE=$(date -v-monday -v-7d '+%Y-%m-%d')
    UNTIL=$(date -v-sunday -v-7d '+%Y-%m-%d 23:59:59')
else
    LABEL="THIS WEEK"
    DOW=$(date '+%u')           # 1=Mon … 7=Sun
    DAYS_BACK=$((DOW - 1))
    SINCE=$(date -v-${DAYS_BACK}d '+%Y-%m-%d')
    UNTIL=$(date '+%Y-%m-%d 23:59:59')
fi

# Extract just the YYYY-MM-DD for date comparisons and icalbuddy
UNTIL_DATE="${UNTIL%% *}"

header "WEEKLY REVIEW  •  $LABEL  ($SINCE → $UNTIL_DATE)"

# ── 1. GIT COMMITS across all projects ──────────────────────────────────────
echo ""
echo "  ${BOLD}Git activity${RESET}"

TOTAL_COMMITS=0
REPOS_ACTIVE=0
GIT_EMAIL=$(git config user.email)

while IFS= read -r -d '' REPO; do
    REPO_DIR=$(dirname "$REPO")
    PROJECT=$(basename "$REPO_DIR")

    COUNT=$(git --no-pager -C "$REPO_DIR" log \
        --after="$SINCE 00:00:00" --before="$UNTIL" \
        ${GIT_EMAIL:+--author="$GIT_EMAIL"} \
        --oneline 2>/dev/null | wc -l | tr -d ' ')

    if [ "${COUNT:-0}" -gt 0 ]; then
        REPOS_ACTIVE=$((REPOS_ACTIVE + 1))
        TOTAL_COMMITS=$((TOTAL_COMMITS + COUNT))
        row "  $PROJECT" "${COUNT} commit(s)"

        git --no-pager -C "$REPO_DIR" log \
            --after="$SINCE 00:00:00" --before="$UNTIL" \
            ${GIT_EMAIL:+--author="$GIT_EMAIL"} \
            --format="    ${CYAN}·${RESET} %s" 2>/dev/null
    fi
done < <(find "$CODING_ROOT" -maxdepth 4 -name ".git" -type d -print0 2>/dev/null)

if [ "$TOTAL_COMMITS" -eq 0 ]; then
    warn "  No commits found this period."
else
    echo ""
    row "  Total commits" "$TOTAL_COMMITS across $REPOS_ACTIVE repo(s)"
fi

# ── 2. COMPLETED TASKS from all todo.md files ───────────────────────────────
echo ""
echo "  ${BOLD}Completed tasks${RESET}"

TOTAL_DONE=0

# Helper: count completed tasks in a file whose (Done: YYYY-MM-DD) falls in [$SINCE, $UNTIL_DATE]
# (or undated - [x] lines if viewing THIS WEEK)
count_completed_in_file() {
    local file="$1"
    local count=0
    while IFS= read -r line; do
        if [[ "$line" =~ '\(Done: ([0-9]{4}-[0-9]{2}-[0-9]{2})' ]]; then
            local done_date="${match[1]}"
            if [[ "$done_date" > "$SINCE" || "$done_date" == "$SINCE" ]] && \
               [[ "$done_date" < "$UNTIL_DATE" || "$done_date" == "$UNTIL_DATE" ]]; then
                count=$((count + 1))
            fi
        elif [[ "$LABEL" == "THIS WEEK" ]]; then
            count=$((count + 1))
        fi
    done < <(grep -E '^[ \t]*[-*] \[x\]' "$file" 2>/dev/null)
    echo "$count"
}

if [ -f "$NOTES_FILE" ]; then
    DONE=$(count_completed_in_file "$NOTES_FILE")
    if [ "$DONE" -gt 0 ]; then
        row "  Global notes" "${DONE} task(s) done"
        TOTAL_DONE=$((TOTAL_DONE + DONE))
    fi
fi

while IFS= read -r -d '' TODO; do
    PROJECT=$(basename "$(dirname "$TODO")")
    DONE=$(count_completed_in_file "$TODO")
    if [ "$DONE" -gt 0 ]; then
        row "  $PROJECT" "${DONE} task(s) done"
        TOTAL_DONE=$((TOTAL_DONE + DONE))
    fi
done < <(find "$CODING_ROOT" -maxdepth 3 -name "todo.md" -print0 2>/dev/null)

if [ "$TOTAL_DONE" -eq 0 ]; then
    warn "  No completed tasks found."
else
    echo ""
    row "  Total done" "$TOTAL_DONE task(s)"
fi

# ── 3. JOURNAL ENTRIES this week ────────────────────────────────────────────
if [ -f "$JOURNAL_FILE" ]; then
    echo ""
    echo "  ${BOLD}Journal entries${RESET}"
    JOURNAL_DAYS=0
    while read -r d; do
        if [[ "$d" > "$SINCE" || "$d" == "$SINCE" ]] && [[ "$d" < "$UNTIL_DATE" || "$d" == "$UNTIL_DATE" ]]; then
            JOURNAL_DAYS=$((JOURNAL_DAYS + 1))
        fi
    done < <(grep -E "^## 20[0-9]{2}-[0-9]{2}-[0-9]{2}" "$JOURNAL_FILE" 2>/dev/null | awk '{print $2}')
    row "  Days journaled" "$JOURNAL_DAYS this week"
fi

# ── 4. CALENDAR EVENTS this week ────────────────────────────────────────────
if command -v icalbuddy &>/dev/null; then
    echo ""
    echo "  ${BOLD}Calendar${RESET}"
    EVENTS=$(icalbuddy -f -ea -nc -npn -b "    • " -eep "notes,url,location" eventsFrom:"$SINCE" to:"$UNTIL_DATE" 2>/dev/null)
    if [ -n "$EVENTS" ]; then
        echo "$EVENTS"
    else
        warn "  No calendar events this period."
    fi
fi

echo ""
ok "That's your week."

