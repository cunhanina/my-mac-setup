#!/bin/zsh
source "$HOME/bin/_styles.sh"

# ---------------------------------------------------------------------------
# journal — lightweight daily markdown journal (companion to `week`)
#
# Writes date-grouped entries (`## YYYY-MM-DD`) to $JOURNAL_FILE
# (`~/Desktop/journal.md` by default), which `week` parses for weekly reviews.
#
# Usage:
#   journal                 view today's journal entry (or recent entries)
#   journal <text>          append a timestamped entry under today's date
#   journal search [query]  fuzzy-browse entries by date with fzf preview
#   journal edit            open $JOURNAL_FILE in $EDITOR
# ---------------------------------------------------------------------------

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    header "journal — Daily Developer Journal"
    row "journal" "View today's entry (or most recent entries)"
    row "journal <thought>" "Append a timestamped bullet under today's date"
    row "journal search [q]" "Fuzzy-search journal dates & entries via fzf"
    row "journal edit" "Open $JOURNAL_FILE in \$EDITOR"
    exit 0
fi

TODAY=$(date '+%Y-%m-%d')
NOW=$(date '+%H:%M')

# Ensure journal file exists with a top-level title
if [[ ! -f "$JOURNAL_FILE" ]]; then
    printf "# 📓 Journal\n" > "$JOURNAL_FILE"
fi

# Helper: extract the section for a specific YYYY-MM-DD date
extract_date_section() {
    local target_date="$1"
    awk -v d="## $target_date" '
        $0 == d { found=1; print; next }
        found && /^## [0-9]{4}-[0-9]{2}-[0-9]{2}/ { exit }
        found { print }
    ' "$JOURNAL_FILE"
}

# MODE: VIEW (no arguments)
if [[ -z "$1" ]]; then
    header "📓 JOURNAL  •  $TODAY"

    SECTION=$(extract_date_section "$TODAY")
    if [[ -n "$SECTION" ]]; then
        if command -v glow &>/dev/null; then
            echo "$SECTION" | glow - -w 0
        elif command -v bat &>/dev/null; then
            echo "$SECTION" | bat --style=plain --language=markdown
        else
            echo "$SECTION"
        fi
    else
        warn "No entry for today ($TODAY) yet."
        info "Add one with: journal <your thought>"
    fi
    exit 0
fi

# MODE: EDIT
if [[ "$1" == "edit" || "$1" == "e" ]]; then
    ${=EDITOR:-code -w} "$JOURNAL_FILE"
    exit 0
fi

# MODE: SEARCH (fzf by date)
if [[ "$1" == "search" || "$1" == "s" ]]; then
    shift
    QUERY="$*"

    if ! command -v fzf &>/dev/null; then
        err "fzf not found. Install with: brew install fzf"
        exit 1
    fi

    DATES=$(grep -E '^## [0-9]{4}-[0-9]{2}-[0-9]{2}' "$JOURNAL_FILE" 2>/dev/null | sed 's/^## //' | sort -r)
    if [[ -z "$DATES" ]]; then
        warn "No journal entries found in $JOURNAL_FILE."
        exit 0
    fi

    PREVIEW_CMD="awk -v d=\"## {}\" '\$0 == d {found=1; print; next} found && /^## [0-9]{4}-[0-9]{2}-[0-9]{2}/ {exit} found {print}' \"$JOURNAL_FILE\""
    if command -v bat &>/dev/null; then
        PREVIEW_CMD="$PREVIEW_CMD | bat --color=always --style=plain --language=markdown"
    fi

    PICK=$(echo "$DATES" | fzf --prompt="Journal date ➜ " \
        --query="$QUERY" \
        --height=60% \
        --reverse \
        --border=rounded \
        --preview="$PREVIEW_CMD" \
        --preview-window="right:65%:wrap")

    [[ -z "$PICK" ]] && exit 0

    header "📓 JOURNAL  •  $PICK"
    extract_date_section "$PICK"
    exit 0
fi

# MODE: ADD ENTRY
ENTRY_TEXT="$*"

if ! grep -q "^## $TODAY$" "$JOURNAL_FILE" 2>/dev/null; then
    printf "\n## %s\n\n" "$TODAY" >> "$JOURNAL_FILE"
fi

echo "- **$NOW** — $ENTRY_TEXT" >> "$JOURNAL_FILE"
ok "Logged to journal ($TODAY @ $NOW)."
