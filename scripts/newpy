#!/bin/zsh
source ~/bin/_styles.sh

if ! command -v step &> /dev/null; then
  step() { echo "  ➜ $1"; }
fi
if ! command -v info &> /dev/null; then
  info() { echo "  ℹ️  $1"; }
fi

if [ -z "$1" ]; then
  err "Usage: newpy <project_name>"
  exit 1
fi

NAME=$1
# Convert hyphens to underscores for the Python package name
PKG_NAME=${NAME//-/_}

BASE_DIR="$HOME/Desktop/coding/python"
TARGET_DIR="$BASE_DIR/$NAME"

header "🚀 Creating Professional Project: $NAME"

# 1. Validation
mkdir -p "$BASE_DIR"
if [ -d "$TARGET_DIR" ]; then
  err "Project '$NAME' already exists in $BASE_DIR."
  exit 1
fi

# 2. Initialize project
# FIX: use plain `uv init` (no --lib) so we control the full structure ourselves.
# --lib auto-creates a src/ folder whose package name may not match $PKG_NAME
# when the project name contains hyphens, leaving pyproject.toml out of sync.
mkdir -p "$TARGET_DIR"
cd "$TARGET_DIR"

step "Initializing uv environment..."
uv init --name "$NAME" --quiet
uv add --dev ruff pytest --quiet

# 3. Build src layout from scratch
step "Structuring source code..."
rm -rf src
mkdir -p "src/$PKG_NAME" "tests"

# A. __init__.py
touch "src/$PKG_NAME/__init__.py"

# B. main.py
cat <<EOF > "src/$PKG_NAME/main.py"
def main():
    """Entry point for the application script"""
    print(f"🚀 $NAME is running from src/$PKG_NAME!")

if __name__ == "__main__":
    main()
EOF

# C. __main__.py
cat <<EOF > "src/$PKG_NAME/__main__.py"
from $PKG_NAME.main import main

if __name__ == "__main__":
    main()
EOF

# D. Basic test
cat <<EOF > "tests/test_core.py"
from $PKG_NAME.main import main

def test_sanity():
    assert 1 + 1 == 2
EOF

# E. Patch pyproject.toml so the src layout is found by the build backend
# FIX: uv init without --lib doesn't add find directives, so imports from src/
# would fail at packaging time without this.
cat >> pyproject.toml <<EOF

[tool.setuptools.packages.find]
where = ["src"]
EOF

# 4. todo.md
# FIX: replaced echo "...\n..." with printf — zsh echo without -e prints
# literal backslash-n, not a newline.
printf "# 📝 To-Do: %s\n\n- [ ] Initial setup complete\n- [ ] \n" "$NAME" > todo.md

# 5. Git setup
step "Initializing Git..."
git init -q
curl -s https://raw.githubusercontent.com/github/gitignore/main/Python.gitignore > .gitignore
# FIX: same \n bug — use printf for reliable newlines in appended blocks
printf "\n# Local Notes\ntodo.md\n" >> .gitignore
printf "\n# VSCode\n.vscode/\n" >> .gitignore

git add .
git commit -m "Initial setup with src layout" -q
ok "Local project structure created."

# 6. GitHub
if command -v gh &>/dev/null; then
    echo "  🔒 Creating PRIVATE repository on GitHub..."
    gh repo create "$NAME" --private --source=. --remote=origin --push > /dev/null
    ok "Live at https://github.com/cunhanina/$NAME (Private)"
else
    warn "GitHub CLI not found. Project is local only."
fi

# 7. Open VS Code
if command -v code &>/dev/null; then
    code .
fi

info "📦 Package: src/$PKG_NAME"
info "👉 Run it:  uv run -m $PKG_NAME"


