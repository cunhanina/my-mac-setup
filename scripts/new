#!/bin/zsh
source ~/bin/_styles.sh

GITHUB_USER="cunhanina"
CODING_ROOT="$HOME/Desktop/coding"

usage() {
    err "Usage: new <language> <project_name>"
    row "Languages" "py, cpp, go"
    exit 1
}

[[ -z "$1" || -z "$2" ]] && usage

LANG=$1
NAME=$2
BASE_DIR="$CODING_ROOT/$LANG"
TARGET_DIR="$BASE_DIR/$NAME"

# --- language scaffolds -----------------------------------------------
# Each function receives $NAME and runs with $TARGET_DIR as cwd.
# Responsible only for source layout + build tooling; shared steps
# (git, todo.md, GitHub, VS Code) live in main().

scaffold_py() {
    local pkg_name=${NAME//-/_}

    step "Initializing uv environment..."
    uv init --name "$NAME" --quiet
    uv add --dev ruff pytest --quiet

    step "Structuring source code..."
    rm -rf src
    mkdir -p "src/$pkg_name" tests
    touch "src/$pkg_name/__init__.py"

    cat <<EOF > "src/$pkg_name/main.py"
def main():
    """Entry point for the application script"""
    print(f"$NAME is running from src/$pkg_name!")

if __name__ == "__main__":
    main()
EOF

    cat <<EOF > "src/$pkg_name/__main__.py"
from $pkg_name.main import main

if __name__ == "__main__":
    main()
EOF

    cat <<EOF > "tests/test_core.py"
from $pkg_name.main import main

def test_sanity():
    assert 1 + 1 == 2
EOF

    cat >> pyproject.toml <<EOF

[tool.setuptools.packages.find]
where = ["src"]
EOF

    GITIGNORE_LANG="Python"
    RUN_HINT="uv run -m $pkg_name"
}

scaffold_cpp() {
    step "Structuring source code with CMake..."
    mkdir -p src include build

    cat <<EOF > "src/main.cpp"
#include <iostream>

int main() {
    std::cout << "$NAME is running from src/main.cpp!" << std::endl;
    return 0;
}
EOF

    cat <<EOF > "CMakeLists.txt"
cmake_minimum_required(VERSION 3.12)
project($NAME)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED True)

include_directories(include)

file(GLOB_RECURSE SOURCES CONFIGURE_DEPENDS "src/*.cpp")

add_executable(\${PROJECT_NAME} \${SOURCES})
EOF

    GITIGNORE_LANG="C++"
    RUN_HINT="cd build && cmake .. && make && ./$NAME"
}

scaffold_go() {
    local module_path="github.com/$GITHUB_USER/$NAME"

    step "Structuring source code with cmd/ + internal/..."
    mkdir -p "cmd/$NAME" "internal"

    cat <<EOF > "cmd/$NAME/main.go"
package main

import "fmt"

func main() {
	fmt.Println("$NAME is running from cmd/$NAME!")
}
EOF

    if command -v go &>/dev/null; then
        go mod init "$module_path" &>/dev/null
    else
        warn "go not found — writing go.mod manually."
        cat <<EOF > go.mod
module $module_path

go 1.23
EOF
    fi

    GITIGNORE_LANG="Go"
    RUN_HINT="go run ./cmd/$NAME"
}

# --- dispatch table -----------------------------------------------------
# Single source of truth: language key -> scaffold function.
# Adding a language means adding one line here and one scaffold_* above.
typeset -A SCAFFOLDS
SCAFFOLDS=(
    py  scaffold_py
    cpp scaffold_cpp
    go  scaffold_go
)

[[ -z "${SCAFFOLDS[$LANG]}" ]] && usage

# --- shared orchestration ------------------------------------------------

header "Creating $LANG project: $NAME"

mkdir -p "$BASE_DIR"
if [[ -d "$TARGET_DIR" ]]; then
    err "Project '$NAME' already exists in $BASE_DIR."
    exit 1
fi

mkdir -p "$TARGET_DIR"
cd "$TARGET_DIR"

"${SCAFFOLDS[$LANG]}"

printf "# To-Do: %s\n\n- [ ] Initial setup complete\n- [ ] \n" "$NAME" > todo.md

step "Initializing Git..."
git init -q
curl -s "https://raw.githubusercontent.com/github/gitignore/main/${GITIGNORE_LANG}.gitignore" > .gitignore
printf "\n# Local Notes\ntodo.md\n" >> .gitignore
printf "\n# VSCode\n.vscode/\n" >> .gitignore

git add .
git commit -m "Initial setup ($LANG)" -q
ok "Local project structure created."

if command -v gh &>/dev/null; then
    step "Creating private repository on GitHub..."
    gh repo create "$NAME" --private --source=. --remote=origin --push > /dev/null
    ok "Live at https://github.com/$GITHUB_USER/$NAME (Private)"
else
    warn "GitHub CLI not found. Project is local only."
fi

if command -v code &>/dev/null; then
    code .
fi

info "Run it: $RUN_HINT"