{
    "workbench.iconTheme": "symbols",
    "window.titleBarStyle": "custom",
    "window.commandCenter": false,
    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",
    "workbench.tips.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.labelFormat": "short",

    // --- TYPOGRAPHY ---
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,

    // --- EDITOR BEHAVIOR ---
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.renderLineHighlight": "gutter",
    "editor.semanticHighlighting.enabled": true,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "visible",
    "editor.stickyScroll.enabled": true,
    "editor.minimap.enabled": false,
    "editor.scrollBeyondLastLine": false,
    "editor.wordWrap": "off",
    "editor.renderWhitespace": "trailing",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.occurrencesHighlight": "multiFile",
    "editor.inlayHints.enabled": "onUnlessPressed",
    "editor.suggest.preview": true,
    "editor.suggest.showStatusBar": true,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.tabCompletion": "onlySnippets",

    // --- EXPLORER ---
    "explorer.compactFolders": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.patterns": {
        "*.py": "${capture}.pyi, ${capture}_test.py, test_${capture}.py",
        "pyproject.toml": "*.cfg, *.ini, .ruff.toml, .mypy.ini, .pre-commit-config.yaml, requirements*.txt, uv.lock, .python-version"
    },

    // --- SEARCH & WATCHER ---
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true
    },

    // --- TERMINAL (macOS M4 / Zsh) ---
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.fontFamily": "JetBrainsMonoNL Nerd Font",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.padding": 12,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.enableMultiLinePasteWarning": "never",

    // --- PYTHON WORKFLOW (uv) ---
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.inlayHints.enabled": "onUnlessPressed"
    },
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.terminal.activateEnvironment": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    // --- GIT ---
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "scm.diffDecorations": "all",

    // --- BREADCRUMBS & MISC ---
    "breadcrumbs.enabled": false,
    "telemetry.telemetryLevel": "off",
    "workbench.colorTheme": "Dracula Purple"
}
